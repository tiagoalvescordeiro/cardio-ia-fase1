[
  {
    "id": "tab_cardio",
    "type": "tab",
    "label": "CardioIA — MQTT",
    "disabled": false,
    "info": "Importe em Node-RED (Menu > Importar). Instale node-red-dashboard se necessário: `npm i node-red-dashboard`"
  },
  {
    "id": "brk_hive",
    "type": "mqtt-broker",
    "name": "broker.hivemq.com",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "nodered_cardioia_g54",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "mqtt_in_tel",
    "type": "mqtt in",
    "z": "tab_cardio",
    "name": "telemetria",
    "topic": "cardioia/grupo54/telemetria",
    "qos": "0",
    "datatype": "utf8",
    "broker": "brk_hive",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 200,
    "y": 160,
    "wires": [["fn_parse"]]
  },
  {
    "id": "fn_parse",
    "type": "function",
    "z": "tab_cardio",
    "name": "parse + alertas",
    "func": "let p;\ntry { p = JSON.parse(msg.payload); } catch (e) { return [[],[],[],[]]; }\nconst t = Number(p.temp_c);\nconst h = Number(p.hum_pct);\nconst b = Number(p.bpm);\nlet alerta = 'OK';\nif (b > 120) alerta = 'ALERTA: BPM elevado';\nif (t > 38.0) alerta = 'ALERTA: febre (temperatura)';\nreturn [[{payload:t}],[{payload:h}],[{payload:b}],[{payload:alerta}]];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 160,
    "wires": [["ui_chart_temp"], ["ui_gauge_hum"], ["ui_chart_bpm"], ["ui_alert"]]
  },
  {
    "id": "ui_tab_mon",
    "type": "ui_tab",
    "z": "tab_cardio",
    "name": "Monitoramento",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui_grp_main",
    "type": "ui_group",
    "z": "tab_cardio",
    "name": "Vitais",
    "tab": "ui_tab_mon",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui_chart_temp",
    "type": "ui_chart",
    "z": "tab_cardio",
    "name": "Temperatura",
    "group": "ui_grp_main",
    "order": 1,
    "width": 6,
    "height": 4,
    "label": "Temperatura (°C)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "aguardando MQTT...",
    "dot": false,
    "ymin": "15",
    "ymax": "45",
    "removeOlder": 1,
    "removeOlderPoints": "200",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#e33131", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd", "#c5b0d5"],
    "useOldStyle": false,
    "outputs": 1,
    "x": 700,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "ui_gauge_hum",
    "type": "ui_gauge",
    "z": "tab_cardio",
    "name": "Umidade",
    "group": "ui_grp_main",
    "order": 2,
    "width": 3,
    "height": 4,
    "gtype": "gage",
    "title": "Umidade relativa",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": "100",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "40",
    "seg2": "70",
    "diff": false,
    "className": "",
    "x": 700,
    "y": 200,
    "wires": []
  },
  {
    "id": "ui_chart_bpm",
    "type": "ui_chart",
    "z": "tab_cardio",
    "name": "BPM",
    "group": "ui_grp_main",
    "order": 3,
    "width": 6,
    "height": 4,
    "label": "BPM (simulado)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "aguardando MQTT...",
    "dot": false,
    "ymin": "40",
    "ymax": "200",
    "removeOlder": 1,
    "removeOlderPoints": "200",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#1f77b4", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd", "#c5b0d5"],
    "useOldStyle": false,
    "outputs": 1,
    "x": 700,
    "y": 300,
    "wires": [[]]
  },
  {
    "id": "ui_alert",
    "type": "ui_text",
    "z": "tab_cardio",
    "group": "ui_grp_main",
    "order": 4,
    "width": 12,
    "height": 1,
    "name": "Alerta",
    "label": "Status",
    "format": "{{msg.payload}}",
    "layout": "row-center",
    "className": "",
    "x": 700,
    "y": 400,
